# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ims?schema=public

# ---- Cache / queues ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- API ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- Object storage (S3 compatible) ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
